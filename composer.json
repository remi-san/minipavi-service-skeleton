{
    "name": "remi-san/minipavi-skeleton",
    "description": "Skeleton of a Minitel service built on the MiniPavi service framework",
    "license": "GPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "monolog/monolog": "^3.13",
        "php-di/php-di": "^7.1",
        "remi-san/minipavi-service": "dev-main"
    },
    "require-dev": {
        "carthage-software/mago": "^1.60",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "App\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "minipavi lint --messages config/messages.xml config",
        "analyse": [
            "mago lint",
            "mago analyze"
        ],
        "cs": "mago format --check",
        "cs-fix": "mago format"
    },
    "scripts-descriptions": {
        "test": "Runs the functional tests (framework's ServiceTester)",
        "lint": "Checks the pages (framework's minipavi lint)",
        "analyse": "Runs the linter and the static analysis (Mago)",
        "cs": "Checks the formatting (Mago)",
        "cs-fix": "Formats the code (Mago)"
    },
    "config": {
        "sort-packages": true
    }
}
